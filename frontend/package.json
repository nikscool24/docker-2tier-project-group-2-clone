{
    "title": "Creative",
    "name": "startbootstrap-creative",
    "version": "7.0.7",
    "scripts": {
        "build": "npm run clean && npm run build:pug && npm run build:scss && npm run build:scripts && npm run build:assets",
        "build:assets": "node scripts/build-assets.js",
        "build:pug": "node scripts/build-pug.js",
        "build:scripts": "node scripts/build-scripts.js",
        "build:scss": "node scripts/build-scss.js",
        "clean": "node scripts/clean.js",
        "start": "npm run build && node scripts/start.js",
        "start:debug": "npm run build && node scripts/start-debug.js",
        "lint": "eslint",
        "format-check": "prettier --check"
    },
    "description": "Creative is a stylish one page HTML theme built with Bootstrap.",
    "keywords": [
        "css",
        "sass",
        "scss",
        "html",
        "pug",
        "responsive",
        "theme",
        "template"
    ],
    "homepage": "https://startbootstrap.com/theme/creative",
    "bugs": {
        "url": "https://github.com/StartBootstrap/startbootstrap-creative/issues",
        "email": "feedback@startbootstrap.com"
    },
    "license": "MIT",
    "author": "Start Bootstrap",
    "contributors": [
        "David Miller (https://davidmiller.io/)"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/StartBootstrap/startbootstrap-creative.git"
    },
    "dependencies": {
        "bootstrap": "5.2.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "autoprefixer": "10.4.14",
        "browser-sync": "^3.0.4",
        "chokidar": "3.5.3",
        "concurrently": "6.3.0",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.7.0",
        "postcss": "^8.5.16",
        "prettier": "^3.9.4",
        "pug": "^3.0.4",
        "sass": "1.60.0",
        "shelljs": "0.8.5",
        "typescript-eslint": "^8.62.1",
        "upath": "2.0.1"
    }
}
